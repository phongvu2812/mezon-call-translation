# All-in-one container: Redis + LiveKit Server + Egress
# Giải quyết vấn đề network trên Windows Docker Desktop

FROM livekit/egress:latest

# Install Redis và supervisor
USER root
RUN apt-get update && apt-get install -y \
    redis-server \
    supervisor \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Download LiveKit server binary
RUN wget -q https://github.com/livekit/livekit/releases/download/v1.7.2/livekit_1.7.2_linux_amd64.tar.gz \
    && tar -xzf livekit_1.7.2_linux_amd64.tar.gz -C /usr/local/bin/ \
    && rm livekit_1.7.2_linux_amd64.tar.gz \
    && chmod +x /usr/local/bin/livekit-server

# Create config directories
RUN mkdir -p /etc/livekit /var/log/supervisor /recordings /home/egress/.cache/xdgr /var/run/pulse \
    && chmod -R 777 /var/log/supervisor /recordings /home/egress /var/run/pulse

# LiveKit server config
COPY livekit.yaml /etc/livekit/livekit.yaml

# Egress config - sử dụng localhost vì cùng container
RUN cat > /etc/livekit/egress.yaml << 'EOF'
api_key: APIForNzhv8Shvk
api_secret: mOuEREmPmJqEM4RfupUGrGe6XdxJi3i0LPOdFPoQLkl

ws_url: ws://localhost:7880
insecure: true

redis:
  address: localhost:6379

file_outputs:
  local:
    directory: /recordings

log_level: info
EOF

# Supervisor config để quản lý tất cả processes
RUN cat > /etc/supervisor/conf.d/supervisord.conf << 'EOF'
[supervisord]
nodaemon=true
user=root
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:redis]
command=redis-server --bind 127.0.0.1 --port 6379
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/redis.log
stderr_logfile=/var/log/supervisor/redis_err.log

[program:livekit]
command=/usr/local/bin/livekit-server --config /etc/livekit/livekit.yaml
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/livekit.log
stderr_logfile=/var/log/supervisor/livekit_err.log

[program:pulseaudio]
command=pulseaudio --system --disallow-exit --disallow-module-loading --exit-idle-time=-1
autostart=true
autorestart=true
stdout_logfile=/var/log/supervisor/pulse.log
stderr_logfile=/var/log/supervisor/pulse_err.log

[program:egress]
command=egress
environment=EGRESS_CONFIG_FILE="/etc/livekit/egress.yaml",HOME="/home/egress",XDG_RUNTIME_DIR="/home/egress/.cache/xdgr"
autostart=true
autorestart=true
startsecs=5
startretries=3
stdout_logfile=/var/log/supervisor/egress.log
stderr_logfile=/var/log/supervisor/egress_err.log
EOF

# Expose ports
EXPOSE 7880 7881 7882/udp

# Override entrypoint để dùng supervisor
ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
